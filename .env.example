# Copy to .env.local and fill in values locally. Never commit real secrets.
# Encode special characters in the DATABASE_URL password using URL encoding.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coolearn_dev?schema=public"

# Local Docker Compose settings; use your own development password.
POSTGRES_USER="coolearn"
POSTGRES_PASSWORD=""
POSTGRES_DB="coolearn_dev"

# Better Auth email/password setup. Generate at least 32 random bytes for SECRET.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
# Keep false for deployment. Test tooling opts in only for local production tests.
ALLOW_LOCAL_HTTP_AUTH="false"

# Optional development seeds. Allowed only on a local database ending in _dev.
ALLOW_DEV_SEED="false"
SEED_PASSWORD=""

# Dedicated local database ending in _test; never use a production/development DB.
TEST_DATABASE_URL=""
E2E_DATABASE_URL=""
RUN_AUTH_E2E="false"

# Future AI service. Keep this server-side; model selection comes in the AI phase.
OPENAI_API_KEY=""

# Classroom / Teams permissions and resource API settings will be specified
# after reviewing current official APIs during the integration phase.
