{
  "name": "coolearn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "smoke": "node scripts/http-smoke.mjs",
    "test": "npm --prefix tests run test",
    "test:watch": "npm --prefix tests run test:watch",
    "test:e2e": "npm --prefix tests run test:e2e",
    "test:install": "npm --prefix tests install",
    "test:policies": "node --experimental-strip-types --test tests/policies/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "test:db": "npm --prefix tests run test:db"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "better-auth": "1.7.7",
    "dotenv": "16.6.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.5.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "20.19.43",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "tsx": "4.23.1"
  }
}
